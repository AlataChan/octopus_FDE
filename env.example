# Planner LLM [OpenAI-compatible API]
# Copy this file to `env` and fill in real values. `env` is gitignored.
# The Planner reads these via os.environ.

OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash

# Optional cost tracking [USD per 1K tokens]; leave unset to disable [cost_usd reports 0.0]
# LOOM_LLM_COST_PER_1K_INPUT=0.00027
# LOOM_LLM_COST_PER_1K_OUTPUT=0.00110

# FDE console deployment auth
# Generate LOOM_FERNET_KEY with:
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
LOOM_FERNET_KEY=replace-me
# Preferred path: run `loom admin init` to write $LOOM_DATA_DIR/auth.json.
# Optional CI/immutable-infra override. If both are set, env wins over auth.json.
# LOOM_AUTH_USERNAME=admin
# LOOM_AUTH_PASSWORD_HASH=scrypt$16384$8$1$replace-salt-b64$replace-hash-b64
# Keep false in production. Set true only for local HTTP debugging without TLS.
LOOM_AUTH_COOKIE_INSECURE_OK=false
LOOM_INSTANCE_ID=local-fde
LOOM_DATA_DIR=./.loom-data
