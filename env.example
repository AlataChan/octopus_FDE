# Planner LLM [OpenAI-compatible API]
# Copy this file to `env` and fill in real values. `env` is gitignored.
# The Planner reads these via os.environ.

OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash

# Optional cost tracking [USD per 1K tokens]; leave unset to disable [cost_usd reports 0.0]
# LOOM_LLM_COST_PER_1K_INPUT=0.00027
# LOOM_LLM_COST_PER_1K_OUTPUT=0.00110
