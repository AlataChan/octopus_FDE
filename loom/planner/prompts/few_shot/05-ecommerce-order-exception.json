{
  "intent": "Triage cross-border ecommerce order exceptions from marketplace or storefront events, classify urgency/sentiment/intent in parallel, and route to the owning operational queue with deterministic priority.",
  "scope": "ecommerce/ops",
  "ir": {
    "ir_version": "0.3",
    "metadata": {
      "name": "Ecommerce Order Exception",
      "description": "Webhook-triggered cross-border ecommerce order exception triage with parallel classifiers, deterministic priority, and routed queues.",
      "owner": "ecommerce-ops",
      "rationale": "Primary ecommerce deep-coverage #2 archetype. Preserves the webhook / parallel object_merge / code priority / condition route skeleton while moving triage to order exceptions."
    },
    "registry_ref": {
      "registry_version": "sha:0000000",
      "tools": [],
      "datasets": [],
      "credentials": []
    },
    "policy": {
      "default_timeout_s": 30,
      "default_retry": { "max_attempts": 2, "backoff": "exponential", "retry_on": ["5xx", "timeout", "rate_limit"] },
      "agent_budget": { "max_iterations": 10, "max_tokens": 50000, "max_wall_clock_s": 300 }
    },
    "inputs": [
      { "name": "message",   "type": "string", "required": true },
      { "name": "sender_id", "type": "string", "required": true }
    ],
    "outputs": [
      { "name": "queue",      "type": "string" },
      { "name": "priority",   "type": "string" },
      { "name": "annotations", "type": "json" }
    ],
    "nodes": [
      {
        "id": "start",
        "type": "trigger",
        "mode": "webhook",
        "rationale": "Order exception events arrive from marketplace or storefront support systems.",
        "webhook": { "path": "/triage", "method": "POST" }
      },
      {
        "id": "analyze",
        "type": "parallel",
        "rationale": "Run independent classifiers in parallel and object-merge their annotations for routing.",
        "merge_strategy": "object_merge",
        "branches": {
          "urgency": [
            {
              "id": "urgency_check",
              "type": "llm",
              "rationale": "Classify order exception urgency for SLA and priority handling.",
              "model": "configured-small-model",
              "system_prompt": "Classify urgency only. Return JSON.",
              "prompt": "Order exception message:\n${input.message}\n\nReturn { urgency: 'low'|'normal'|'high'|'critical' }.",
              "temperature": 0,
              "output_schema": {
                "type": "object",
                "required": ["urgency"],
                "properties": { "urgency": { "type": "string", "enum": ["low", "normal", "high", "critical"] } }
              }
            }
          ],
          "sentiment": [
            {
              "id": "sentiment_check",
              "type": "llm",
              "rationale": "Detect buyer sentiment so angry or escalated cases receive faster handling.",
              "model": "configured-small-model",
              "system_prompt": "Classify sentiment only. Return JSON.",
              "prompt": "Order exception message:\n${input.message}\n\nReturn { sentiment: 'positive'|'neutral'|'negative'|'angry' }.",
              "temperature": 0,
              "output_schema": {
                "type": "object",
                "required": ["sentiment"],
                "properties": { "sentiment": { "type": "string", "enum": ["positive", "neutral", "negative", "angry"] } }
              }
            }
          ],
          "intent": [
            {
              "id": "intent_classify",
              "type": "llm",
              "rationale": "Classify the order exception intent into the operational queue taxonomy.",
              "model": "configured-planner-model",
              "system_prompt": "Classify order exception intent. Return JSON.",
              "prompt": "Order exception message:\n${input.message}\n\nReturn { intent: 'refund'|'shipping'|'marketplace'|'general' }.",
              "temperature": 0,
              "output_schema": {
                "type": "object",
                "required": ["intent"],
                "properties": { "intent": { "type": "string", "enum": ["refund", "shipping", "marketplace", "general"] } }
              }
            }
          ]
        }
      },
      {
        "id": "decide_priority",
        "type": "code",
        "rationale": "Map urgency and sentiment into deterministic support priorities before queue routing.",
        "language": "python",
        "source": "if analyze['urgency'] == 'critical' or analyze['sentiment'] == 'angry':\n    return { 'priority': 'P1' }\nif analyze['urgency'] == 'high':\n    return { 'priority': 'P2' }\nreturn { 'priority': 'P3' }",
        "inputs": { "analyze": "${analyze}" },
        "output_schema": {
          "type": "object",
          "required": ["priority"],
          "properties": { "priority": { "type": "string", "enum": ["P1", "P2", "P3"] } }
        }
      },
      {
        "id": "route",
        "type": "condition",
        "rationale": "Route each order exception to the owning operational queue, defaulting to general support.",
        "branches": [
          { "when": "${analyze.intent} == 'refund'",      "next": "billing_out" },
          { "when": "${analyze.intent} == 'shipping'",    "next": "tech_out" },
          { "when": "${analyze.intent} == 'marketplace'", "next": "account_out" }
        ],
        "default": "general_out"
      },
      {
        "id": "billing_out",
        "type": "output",
        "rationale": "Refund-related exceptions route to the refund and payments queue.",
        "bindings": {
          "queue":       "refunds-team",
          "priority":    "${decide_priority.priority}",
          "annotations": "${analyze}"
        }
      },
      {
        "id": "tech_out",
        "type": "output",
        "rationale": "Shipping exceptions route to logistics support for carrier or fulfillment action.",
        "bindings": {
          "queue":       "logistics-support",
          "priority":    "${decide_priority.priority}",
          "annotations": "${analyze}"
        }
      },
      {
        "id": "account_out",
        "type": "output",
        "rationale": "Marketplace policy exceptions route to the marketplace operations queue.",
        "bindings": {
          "queue":       "marketplace-ops",
          "priority":    "${decide_priority.priority}",
          "annotations": "${analyze}"
        }
      },
      {
        "id": "general_out",
        "type": "output",
        "rationale": "Unclassified order exceptions fall back to the general ecommerce support queue.",
        "bindings": {
          "queue":       "general-queue",
          "priority":    "${decide_priority.priority}",
          "annotations": "${analyze}"
        }
      }
    ],
    "edges": [
      { "from": "start",            "to": "analyze" },
      { "from": "analyze",          "to": "decide_priority" },
      { "from": "decide_priority",  "to": "route" }
    ]
  }
}
