{
  "ir_version": "0.2",
  "metadata": {
    "name": "RAG Q&A",
    "description": "Retrieval-augmented Q&A with re-rank and citation. Baseline workflow — exercises trigger/retrieval/llm/output and llm.output_schema.",
    "owner": "data-ops"
  },
  "registry_ref": {
    "registry_version": "2026-04-15",
    "tools": [],
    "datasets": ["docs_kb"],
    "credentials": []
  },
  "policy": {
    "default_timeout_s": 60,
    "default_retry": { "max_attempts": 3, "backoff": "exponential", "retry_on": ["5xx", "timeout", "rate_limit"] },
    "agent_budget": { "max_iterations": 10, "max_tokens": 50000 }
  },
  "inputs": [
    { "name": "query", "type": "string", "required": true }
  ],
  "outputs": [
    { "name": "answer",  "type": "string" },
    { "name": "sources", "type": "string[]" }
  ],
  "nodes": [
    { "id": "start", "type": "trigger", "mode": "manual" },
    {
      "id": "retrieve",
      "type": "retrieval",
      "dataset": "docs_kb",
      "query": "${input.query}",
      "top_k": 20
    },
    {
      "id": "rerank",
      "type": "llm",
      "model": "claude-haiku-4-5-20251001",
      "system_prompt": "You re-rank candidate passages by relevance to the query. Return only the indices.",
      "prompt": "Query: ${input.query}\n\nPassages:\n${retrieve.chunks}\n\nReturn the 5 most relevant passage indices in JSON.",
      "temperature": 0,
      "output_schema": {
        "type": "object",
        "required": ["top_indices"],
        "properties": {
          "top_indices": { "type": "array", "items": { "type": "integer" }, "minItems": 1, "maxItems": 5 }
        }
      }
    },
    {
      "id": "answer",
      "type": "llm",
      "model": "claude-sonnet-4-6",
      "system_prompt": "Answer the user's query using only the provided context. Cite sources by index.",
      "prompt": "Query: ${input.query}\n\nTop passage indices: ${rerank.top_indices}\nFull retrieval: ${retrieve.chunks}\n\nProduce a JSON answer.",
      "temperature": 0.2,
      "output_schema": {
        "type": "object",
        "required": ["answer", "sources"],
        "properties": {
          "answer":  { "type": "string" },
          "sources": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    {
      "id": "out",
      "type": "output",
      "bindings": {
        "answer":  "${answer.answer}",
        "sources": "${answer.sources}"
      }
    }
  ],
  "edges": [
    { "from": "start",    "to": "retrieve" },
    { "from": "retrieve", "to": "rerank" },
    { "from": "rerank",   "to": "answer" },
    { "from": "answer",   "to": "out" }
  ]
}
